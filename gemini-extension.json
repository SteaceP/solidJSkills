{
  "name": "solidjskills",
  "version": "1.2.5",
  "description": "Browse solidJSkills docs from Gemini CLI via MCP tools.",
  "contextFileName": "GEMINI.md",
  "mcpServers": {
    "solidjskills-docs": {
      "command": "node",
      "args": [
        "${extensionPath}${/}mcp-server${/}src${/}index.js"
      ],
      "cwd": "${extensionPath}"
    }
  }
}