{
    "name": "solidjskills-root",
    "version": "1.3.0",
    "description": "Root package for SolidJSkills repository tooling",
    "type": "module",
    "scripts": {
        "test": "npm run validate && npm run smoke && npm --prefix mcp-server test && npm run test:integration",
        "test:integration": "node tests/integration/mcp-server.test.mjs",
        "validate": "npm run validate:corpus && npm run validate:skills && npm run validate:contracts",
        "validate:corpus": "node tools/scripts/validate-solid-corpus.mjs",
        "validate:skills": "node tools/scripts/validate-skills.mjs",
        "validate:contracts": "node tools/scripts/validate-output-contracts.mjs",
        "normalize": "node tools/scripts/normalize-solid-docs.mjs",
        "smoke": "node tools/scripts/run-smoke-evals.mjs",
        "audit": "node tools/scripts/audit-solid-code.mjs",
        "scaffold": "node tools/scripts/scaffold-skill.mjs",
        "release": "node tools/scripts/release.mjs",
        "release:patch": "node tools/scripts/release.mjs patch",
        "release:minor": "node tools/scripts/release.mjs minor",
        "release:major": "node tools/scripts/release.mjs major"
    },
    "devDependencies": {},
    "engines": {
        "node": ">=24"
    }
}